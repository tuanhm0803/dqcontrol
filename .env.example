# Sao chép thành .env rồi chỉnh sửa. Biến môi trường hệ thống được ưu tiên hơn file .env.

APP_NAME=DQ Dashboard
DEBUG=false
LOG_LEVEL=INFO

# Bắt buộc đặt ở môi trường thật (tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
SESSION_MAX_AGE=28800
# Đặt true nếu chạy sau reverse proxy HTTPS
SESSION_HTTPS_ONLY=false

# ---------- Active Directory ----------
MOCK_LDAP=true
LDAP_SERVER=dc01.corp.local
LDAP_USE_SSL=true
LDAP_PORT=636
LDAP_UPN_SUFFIX=corp.local
LDAP_BASE_DN=DC=corp,DC=local
LDAP_TIMEOUT=5
LDAP_BRANCH_ATTRIBUTE=physicalDeliveryOfficeName
LDAP_NESTED_GROUPS=false
LDAP_GROUP_ADMIN=DQ_ADMIN
LDAP_GROUP_USER=DQ_USER
# Phê duyệt QTDL / Phê duyệt nghiệp vụ / Lãnh đạo phòng ban chi nhánh
LDAP_GROUP_APPROVER=DQ_APPROVER
LDAP_GROUP_BUSINESS=DQ_BUSINESS
LDAP_GROUP_MANAGER=DQ_MANAGER

# ---------- Database ----------
USE_MOCK_DATA=true
# File SQLite chứa dữ liệu giả lập (tự tạo; xóa / chạy "python database.py reset-mock" để làm mới)
MOCK_DATABASE_URL=sqlite:///./dq_mock.db
DB_FALLBACK_TO_MOCK=true
# SQL Server: mssql+pyodbc://user:pass@host:1433/DQ?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Oracle:     oracle+oracledb://user:pass@host:1521/?service_name=ORCLPDB1
# PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dq
DATABASE_URL=sqlite:///./dq_demo.db
DQ_TABLE_NAME=dq_errors
DQ_TABLE_SCHEMA=
# Schema cho bảng của ứng dụng: dq_exclusion_requests, dq_user_permissions, dq_audit_log
APP_TABLE_SCHEMA=
DB_ECHO=false

PAGE_SIZE=25
EXPORT_MAX_ROWS=100000
# Yêu cầu loại trừ: độ dài tối thiểu của lý do, giới hạn số dòng / dung lượng file Excel upload
EXCLUSION_REASON_MIN_LENGTH=10
EXCLUSION_UPLOAD_MAX_ROWS=2000
EXCLUSION_UPLOAD_MAX_MB=5
# File bằng chứng (ảnh JPG/PNG/GIF/WEBP hoặc PDF) cho từng yêu cầu: thư mục lưu (bỏ trống = thư mục evidence cạnh app),
# số file tối đa mỗi yêu cầu, dung lượng tối đa mỗi file (MB). Nhớ sao lưu thư mục này.
EVIDENCE_DIR=
EVIDENCE_MAX_FILES=3
EVIDENCE_MAX_MB=3
